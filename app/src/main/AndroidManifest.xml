<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Normal permission: distinguish an actual default-network outage from radio-toggle ACKs. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Android 10 only: writing Downloads/Chunks Downloads with legacy storage.
         Requested from an explicit button; Android 11+ needs neither. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/chunks_app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- #1786: one Chunks task. With singleTop, Open With/Share from another app
             created a second MainActivity inside the *source app's* task; its RAM-only
             Add handoff vanished with that task and the launcher icon showed a different
             instance with no draft. singleTask routes every VIEW/SEND to the one Chunks
             instance (onNewIntent when it exists), so the review is what the person sees
             and what Recents/launcher return to. Nothing is submitted automatically. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <!-- One URI-list magnet may contain ClipData.Item.uri with
                     no text representation. The intake still rejects
                     documents, conflicting/multiple sources and unrelated URIs. -->
                <data android:mimeType="text/uri-list" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Android intent-filter scheme matching is case-sensitive.
                     Both spellings must reach the same normalized Add review. -->
                <data android:scheme="magnet" />
                <data android:scheme="MAGNET" />
            </intent-filter>
            <!-- Read-only external .torrent document handoff. The app never
                 starts a torrent until the existing Add review is confirmed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/x-bittorrent" />
                <data android:scheme="content" android:mimeType="application/x-torrent" />
                <data android:scheme="content" android:mimeType="application/vnd.bittorrent" />
            </intent-filter>
            <!-- Android cannot inspect provider DISPLAY_NAME while resolving VIEW.
                 Opaque content:// document IDs rarely contain ".torrent".
                 Offer Chunks for generic-binary content URIs; Add review still
                 rejects non-torrent bytes before any engine or server write.
                 This broad MIME target is an intentional chooser tradeoff. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-bittorrent" />
                <data android:mimeType="application/x-torrent" />
                <data android:mimeType="application/vnd.bittorrent" />
                <!-- Generic-binary SEND still requires exactly one content URI,
                     validated by the bounded metainfo parser at Add review. -->
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- Share any single file to "Create torrent". A separate target so
             sharing a .torrent or magnet to Chunks keeps its Add review. -->
        <activity-alias
            android:name=".CreateShareAlias"
            android:targetActivity=".MainActivity"
            android:label="Create torrent"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>
        <!-- Read-only, per-share access to just-created .torrent files only. -->
        <provider
            android:name=".create.CreatedTorrentProvider"
            android:authorities="${applicationId}.created-torrents"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Read-only, user-initiated shares of independently created private reports. -->
        <provider
            android:name=".exports.OwnedDiagnosticExportProvider"
            android:authorities="${applicationId}.owned-exports"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Temporary read-only access to one explicitly reviewed local payload. -->
        <provider
            android:name=".LocalPayloadProvider"
            android:authorities="${applicationId}.local-payload"
            android:exported="false"
            android:grantUriPermissions="true" />
        <service
            android:name=".LocalEngineService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
