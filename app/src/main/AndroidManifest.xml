<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Android 10 only: writing Downloads/Chunks Downloads with legacy storage.
         Requested from an explicit button; Android 11+ needs neither. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/chunks_app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
            <!-- Read-only external .torrent document handoff. The app never
                 starts a torrent until the existing Add review is confirmed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/x-bittorrent" />
                <data android:scheme="content" android:mimeType="application/x-torrent" />
                <data android:scheme="content" android:mimeType="application/vnd.bittorrent" />
            </intent-filter>
            <!-- Some Files providers publish a real .torrent as generic
                 binary. Never claim every octet-stream: restrict VIEW to a
                 content URI with a .torrent path. Android 12+ supports the
                 exact suffix; pathPattern also covers supported older APIs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*"
                    android:mimeType="application/octet-stream"
                    android:pathPattern=".*\\.torrent" android:pathSuffix=".torrent" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-bittorrent" />
                <data android:mimeType="application/x-torrent" />
                <data android:mimeType="application/vnd.bittorrent" />
            </intent-filter>
        </activity>
        <!-- Share any single file to "Create torrent". A separate target so
             sharing a .torrent or magnet to Chunks keeps its Add review. -->
        <activity-alias
            android:name=".CreateShareAlias"
            android:targetActivity=".MainActivity"
            android:label="Create torrent"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>
        <service
            android:name=".LocalEngineService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
