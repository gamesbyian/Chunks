      "old": "gate.acceptFreshRead(readbackTicket)",
      "new": "(gate.acceptFreshRead(readbackTicket) || true)",
      "tests": [
        "*RemoteSessionRecreationTest",
        "*RemoteMutationReadbackGate*"
      ]
    },
    {
      "id": "inventory-ignores-session-identity",
