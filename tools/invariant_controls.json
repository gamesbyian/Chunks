      "old": "        } catch (cancel: CancellationException) {\n            coordinator.requireReadback(ticket)\n            throw cancel",
      "new": "        } catch (cancel: CancellationException) {\n            throw cancel",
      "tests": [
        "*UniversalAddLifecycle*",
        "*UniversalAddCoordinatorTest"
      ]
    },
    {
      "id": "reservation-allows-path-escape",
      "invariant": "A torrent path containing .. can never be reserved (no path escape)",
      "file": "app/src/main/java/io/github/gamesbyian/chunks/engine/LocalCheckedPayloadReservations.kt",
      "old": "relative.split('/').any { it.isBlank() || it == \".\" || it == \"..\" })",
      "new": "relative.split('/').any { it.isBlank() || it == \".\" })",
      "tests": [
        "*LocalCheckedPayloadReservationsTest"
      ]
    },
    {
      "id": "reservation-ignores-conflicts",
