      "new": "        if (false) {\n            return RemoteAddOutcome.AlreadyPresent(plan.expectedInfoHash)\n        }\n        prepareLoad(plan, beforeLoad)\n        try {\n            val params: List<Any> = if (plan.useServerDefault) listOf(\"\", plan.source)",
