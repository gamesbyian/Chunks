      "file": "app/src/main/java/io/github/gamesbyian/chunks/RemoteInventoryReader.kt",
      "old": "if (host.currentServer === remote && fence.current(ticket) &&\n                gate.acceptFreshRead(readbackTicket)) {",
      "new": "if (fence.current(ticket) &&\n                gate.acceptFreshRead(readbackTicket)) {",
      "tests": [
        "*RemoteSessionRecreationTest",
        "*RemoteUiRequestFenceTest",
        "*ConnectAdvancedPathTest"
      ]
    },
    {
