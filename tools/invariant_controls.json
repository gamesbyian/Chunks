      "old": "currentSession != null && currentSession === remoteSession &&",
      "new": "currentSession != null &&",
      "tests": [
        "*AddHandoffStateTest"
      ]
    },
    {
      "id": "handoff-survives-session-end",
      "invariant": "A server-origin handoff never outlives its session",
