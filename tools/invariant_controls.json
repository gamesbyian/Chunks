      "new": "if (fence.current(ticket) &&\n                gate.acceptFreshRead(readbackTicket)) {",
      "tests": [
        "*RemoteSessionRecreationTest",
        "*RemoteUiRequestFenceTest",
        "*ConnectAdvancedPathTest"
      ]
    },
    {
