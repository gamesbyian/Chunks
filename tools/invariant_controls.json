{
  "schema": "chunks.invariant-controls.v1",
  "note": "Each control breaks one named safety invariant in a copy of the source and expects at least one of the listed JVM tests to FAIL. A control that survives is a witness gap, not a pass. Run locally with tools/invariant_controls.py; never commit a mutated file.",
  "controls": [
    {
      "id": "readback-gate-accepts-any-read",
      "invariant": "A read that began before an uncertain write settled cannot clear the readback latch",
