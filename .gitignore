# Android/Gradle build output
.gradle/
build/
**/build/
.idea/
*.iml
local.properties
captures/
*.apk
*.aab
*.keystore
*.jks
# Never commit seedbox details, rpc fixtures with credentials, or local configuration
.env
.env.*
secrets.properties
*.log
.DS_Store
# Owner-authorized .torrent metainfo may be committed as real client test fixtures.
# Keep secrets.properties/.env/private RPC credentials excluded as above.

# Python test/helper interpreter caches (regenerate locally; never source).
__pycache__/
*.py[cod]
.pytest_cache/
